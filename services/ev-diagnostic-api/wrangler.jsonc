{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hijjawix-ev-diagnostic-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "routes": [
    { "pattern": "ev-api.hijjawix.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "DEVICE_HUBS", "class_name": "DeviceHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Registry", "DeviceHub"] }
  ],
  "observability": { "enabled": true }
}
